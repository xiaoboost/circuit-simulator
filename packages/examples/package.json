{
  "name": "@circuit/examples",
  "description": "circuit's examples sheet",
  "version": "1.0.0",
  "author": "xiaoboost",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./*": {
      "source": "./src/*.ts",
      "import": "./src/*.ts",
      "types": "./src/*.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "build:cjs": "tsc -p ./tsconfig.json",
    "build": "pnpm run clear && pnpm run build:cjs",
    "watch": "pnpm run build -w",
    "lint:type": "pnpm run build:cjs --noEmit",
    "lint:style": "eslint -c eslint.config.mjs",
    "lint:fix": "eslint --fix -c eslint.config.mjs",
    "lint": "pnpm run lint:type && pnpm run lint:style"
  },
  "dependencies": {
    "@circuit/algorithm": "workspace:*",
    "@circuit/types": "workspace:*"
  },
  "devDependencies": {
    "@circuit/eslint-config": "workspace:*",
    "@types/circuit": "workspace:*",
    "@xiao-ai/tsconfig": "1.0.4",
    "eslint": "9.39.1",
    "rimraf": "6.1.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  }
}
