{
  "name": "@circuit/website",
  "description": "在线电路仿真系统",
  "version": "2.0.0-alpha.0",
  "author": "xiaoboost",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "webpack": "node --import tsx node_modules/webpack/bin/webpack.js",
    "dev": "pnpm run clear && cross-env NODE_ENV=development npm run webpack -- serve -c ./build/webpack.dev.ts",
    "build": "pnpm run clear && cross-env NODE_ENV=production npm run webpack -- build -c ./build/webpack.prod.ts",
    "analyze": "pnpm run clear && cross-env NODE_ENV=production ANALYZE=true npm run webpack -- -c build/webpack.prod.ts",
    "lint:style": "eslint -c eslint.config.mjs",
    "lint:fix": "eslint --fix -c eslint.config.mjs",
    "lint": "pnpm run lint:style"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@circuit/algorithm": "workspace:*",
    "@circuit/electronics": "workspace:*",
    "@circuit/examples": "workspace:*",
    "@circuit/icons": "workspace:*",
    "@circuit/inject": "workspace:*",
    "@circuit/painter": "workspace:*",
    "@circuit/reactive": "workspace:*",
    "@circuit/shared": "workspace:*",
    "@circuit/types": "workspace:*",
    "@xiao-ai/utils": "1.6.7",
    "antd": "5.26.7",
    "core-js": "3.44.0",
    "debounce": "2.2.0",
    "immer": "10.1.1",
    "localforage": "1.10.0",
    "qs": "6.14.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@circuit/eslint-config": "workspace:*",
    "@types/circuit": "workspace:*",
    "@types/node": "20.19.0",
    "@types/qs": "6.14.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/webpack-bundle-analyzer": "4.7.0",
    "@xiao-ai/tsconfig": "1.0.4",
    "cross-env": "7.0.3",
    "css-loader": "7.1.2",
    "css-minimizer-webpack-plugin": "7.0.2",
    "eslint": "9.32.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "html-webpack-plugin": "5.6.3",
    "less-loader": "12.3.0",
    "mini-css-extract-plugin": "2.9.2",
    "rimraf": "6.0.1",
    "swc-loader": "0.2.6",
    "terser-webpack-plugin": "5.3.14",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "webpack": "5.101.0",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2",
    "webpack-progress-ora-plugin": "1.5.10",
    "worker-loader": "3.0.8"
  }
}
