{
  "name": "@circuit/website",
  "description": "在线电路仿真系统",
  "version": "2.0.0-alpha.0",
  "author": "xiaoboost",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "webpack": "node --import tsx node_modules/webpack/bin/webpack.js",
    "dev": "pnpm run clear && cross-env NODE_ENV=development npm run webpack -- serve -c ./webpack.config.ts",
    "build": "pnpm run clear && cross-env NODE_ENV=production npm run webpack -- build -c ./webpack.config.ts",
    "analyze": "pnpm run clear && cross-env NODE_ENV=production ANALYZE=true npm run webpack -- -c ./webpack.config.ts",
    "lint:style": "eslint -c eslint.config.mjs",
    "lint:fix": "eslint --fix -c eslint.config.mjs",
    "lint": "pnpm run lint:style"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@circuit/algorithm": "workspace:*",
    "@circuit/contracts": "workspace:*",
    "@circuit/electronics": "workspace:*",
    "@circuit/examples": "workspace:*",
    "@circuit/icons": "workspace:*",
    "@circuit/inject": "workspace:*",
    "@circuit/painter": "workspace:*",
    "@circuit/reactive": "workspace:*",
    "@circuit/shared": "workspace:*",
    "@circuit/types": "workspace:*",
    "@xiao-ai/utils": "1.6.7",
    "antd": "5.28.1",
    "core-js": "3.46.0",
    "debounce": "3.0.0",
    "hotkeys-js": "3.13.15",
    "immer": "10.2.0",
    "localforage": "1.10.0",
    "qs": "6.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@circuit/build-config": "workspace:*",
    "@circuit/eslint-config": "workspace:*",
    "@types/circuit": "workspace:*",
    "@types/node": "20.19.0",
    "@types/qs": "6.14.0",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "@xiao-ai/tsconfig": "1.0.4",
    "cross-env": "7.0.3",
    "eslint": "9.39.1",
    "rimraf": "6.1.0",
    "tslib": "2.8.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "webpack": "5.102.1",
    "webpack-cli": "6.0.1"
  }
}
