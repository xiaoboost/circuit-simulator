{
  "name": "@circuit/website",
  "description": "在线电路仿真系统",
  "version": "2.0.0-alpha.0",
  "author": "xiaoboost",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "webpack": "node -r tsm node_modules/webpack/bin/webpack.js",
    "dev": "cross-env NODE_ENV=development npm run webpack -- serve -c ./build/webpack.dev.ts",
    "build": "cross-env NODE_ENV=production npm run webpack -- build -c ./build/webpack.prod.ts",
    "analyze": "cross-env NODE_ENV=production ANALYZE=true npm run webpack -- -c build/webpack.prod.ts",
    "lint": "eslint --quiet --no-error-on-unmatched-pattern --config ../../.eslintrc.js src/**/*.{ts,tsx,js,jsx}",
    "lint:fix": "eslint --fix --quiet --no-error-on-unmatched-pattern --config ../../.eslintrc.js src/**/*.{ts,tsx,js,jsx}"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "require": [
      "ts-node/register/transpile-only",
      "tsconfig-paths/register",
      "./tests/setup.ts"
    ],
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.json"
    },
    "files": [
      "tests/**/*.spec.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoboost/circuit-simulator.git"
  },
  "dependencies": {
    "@ant-design/icons": "5.0.1",
    "@antv/g2": "4.2.10",
    "@circuit/debug": "workspace:*",
    "@circuit/electronics": "workspace:*",
    "@circuit/event": "workspace:*",
    "@circuit/map": "workspace:*",
    "@circuit/math": "workspace:*",
    "@circuit/solver": "workspace:*",
    "@circuit/worker": "workspace:*",
    "@xiao-ai/utils": "1.6.6",
    "antd": "5.3.3",
    "core-js": "3.29.1",
    "jss": "10.10.0",
    "jss-plugin-camel-case": "10.10.0",
    "jss-plugin-default-unit": "10.10.0",
    "jss-plugin-expand": "10.10.0",
    "jss-plugin-extend": "10.10.0",
    "jss-plugin-nested": "10.10.0",
    "jss-plugin-rule-value-function": "10.10.0",
    "qs": "6.11.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/circuit": "workspace:*",
    "@types/node": "16.0.0",
    "@types/qs": "6.9.7",
    "@types/react": "18.0.31",
    "@types/react-dom": "18.0.11",
    "@types/webpack-bundle-analyzer": "4.6.0",
    "@xiao-ai/tsconfig": "1.0.3",
    "ava": "5.2.0",
    "browser-env": "3.3.0",
    "chalk": "5.2.0",
    "copy-webpack-plugin": "11.0.0",
    "cross-env": "7.0.3",
    "css-loader": "6.7.3",
    "css-minimizer-webpack-plugin": "5.0.0",
    "eslint": "8.37.0",
    "file-loader": "6.2.0",
    "html-webpack-plugin": "5.5.0",
    "mini-css-extract-plugin": "2.7.5",
    "progress-bar-webpack-plugin": "2.1.0",
    "terser-webpack-plugin": "5.3.7",
    "ts-loader": "9.4.2",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.5.0",
    "tsm": "2.3.0",
    "typescript": "5.0.3",
    "url-loader": "4.1.1",
    "webpack": "5.77.0",
    "webpack-bundle-analyzer": "4.8.0",
    "webpack-cli": "5.0.1",
    "webpack-dev-server": "4.13.2",
    "worker-loader": "3.0.8"
  }
}
