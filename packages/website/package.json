{
  "name": "@circuit/website",
  "description": "在线电路仿真系统",
  "version": "2.0.0-alpha.0",
  "author": "xiaoboost",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "webpack": "node --import tsx node_modules/webpack/bin/webpack.js",
    "dev": "pnpm run clear && cross-env NODE_ENV=development npm run webpack -- serve -c ./build/webpack.dev.ts",
    "build": "pnpm run clear && cross-env NODE_ENV=production npm run webpack -- build -c ./build/webpack.prod.ts",
    "analyze": "pnpm run clear && cross-env NODE_ENV=production ANALYZE=true npm run webpack -- -c build/webpack.prod.ts",
    "lint": "eslint -c eslint.config.mjs",
    "lint:fix": "eslint --fix -c eslint.config.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.5.2",
    "@antv/g2": "5.3.2",
    "@circuit/algorithm": "workspace:*",
    "@circuit/electronics": "workspace:*",
    "@circuit/map": "workspace:*",
    "@circuit/painter": "workspace:*",
    "@circuit/shared": "workspace:*",
    "@circuit/solver": "workspace:*",
    "@floating-ui/dom": "1.6.13",
    "@vanilla-extract/css": "1.17.0",
    "@vanilla-extract/css-utils": "0.1.4",
    "@xiao-ai/utils": "1.6.6",
    "antd": "5.24.9",
    "core-js": "3.40.0",
    "immer": "10.1.1",
    "localforage": "1.10.0",
    "qs": "6.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@circuit/eslint-config": "workspace:*",
    "@types/circuit": "workspace:*",
    "@types/node": "20.12.8",
    "@types/qs": "6.9.18",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/webpack-bundle-analyzer": "4.7.0",
    "@vanilla-extract/webpack-plugin": "2.3.16",
    "@xiao-ai/tsconfig": "1.0.4",
    "ava": "6.2.0",
    "browser-env": "3.3.0",
    "copy-webpack-plugin": "12.0.2",
    "cross-env": "7.0.3",
    "css-loader": "7.1.2",
    "css-minimizer-webpack-plugin": "7.0.0",
    "eslint": "9.17.0",
    "file-loader": "6.2.0",
    "html-webpack-plugin": "5.6.3",
    "mini-css-extract-plugin": "2.9.0",
    "rimraf": "5.0.5",
    "single-line-log": "1.1.2",
    "terser-webpack-plugin": "5.3.10",
    "ts-loader": "9.5.2",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "url-loader": "4.1.1",
    "webpack": "5.97.1",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.0",
    "webpack-progress-ora-plugin": "1.5.10",
    "worker-loader": "3.0.8"
  }
}
