{
  "name": "@circuit/event",
  "description": "circuit's event controller",
  "version": "1.0.0",
  "author": "xiaoboost",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "build:cjs": "tsc -p ./tsconfig.build.json --outDir dist/cjs --module CommonJs",
    "build:esm": "tsc -p ./tsconfig.build.json --outDir dist/esm --module ESNext",
    "build": "pnpm run clear && pnpm run build:cjs && pnpm run build:esm",
    "lint": "eslint --quiet src/**/*.{ts,tsx,js,jsx}",
    "lint:fix": "eslint --quiet --fix src/**/*.{ts,tsx,js,jsx}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoboost/circuit-simulator.git"
  },
  "dependencies": {
    "@circuit/math": "workspace:*",
    "@xiao-ai/utils": "1.6.6",
    "react": "18.2.0"
  },
  "devDependencies": {
    "@types/circuit": "workspace:*",
    "@types/node": "16.0.0",
    "@types/react": "18.0.31",
    "@xiao-ai/eslint-config": "1.0.3",
    "@xiao-ai/tsconfig": "1.0.4",
    "ava": "5.2.0",
    "eslint": "8.56.0",
    "rimraf": "5.0.1",
    "ts-node": "10.9.1",
    "tslib": "2.6.2",
    "typescript": "5.2.2"
  }
}
