{
  "name": "@circuit/math",
  "description": "circuit's math",
  "version": "1.0.0",
  "author": "xiaoboost",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "test": "ava --no-cache --config ./ava.config.js",
    "build:cjs": "tsc -p ./tsconfig.build.json",
    "build": "pnpm run clear && pnpm run build:cjs",
    "watch": "pnpm run build -w",
    "lint": "eslint -c eslint.config.mjs",
    "lint:fix": "eslint --fix -c eslint.config.mjs"
  },
  "dependencies": {
    "@xiao-ai/utils": "1.6.6",
    "bignumber.js": "9.1.2"
  },
  "devDependencies": {
    "@circuit/eslint-config": "workspace:*",
    "@circuit/test-toolkit": "workspace:*",
    "@types/circuit": "workspace:*",
    "@types/node": "20.12.8",
    "@xiao-ai/tsconfig": "1.0.4",
    "ava": "6.2.0",
    "eslint": "9.17.0",
    "rimraf": "5.0.5",
    "tslib": "2.8.1",
    "typescript": "5.8.3"
  }
}
