{
  "name": "@circuit/solver",
  "description": "circuit's solver",
  "version": "1.0.0",
  "author": "xiaoboost",
  "license": "MIT",
  "source": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "test": "ava --no-cache",
    "test:update": "rimraf ./tests/snapshots && ava --no-cache",
    "build:cjs": "tsc -p ./tsconfig.build.json",
    "build": "pnpm run clear && pnpm run build:cjs",
    "watch": "pnpm run build -w",
    "lint": "eslint --quiet src/**/*.{ts,tsx,js,jsx}",
    "lint:fix": "eslint --quiet --fix src/**/*.{ts,tsx,js,jsx}"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "require": [
      "tsx"
    ],
    "environmentVariables": {
      "TS_NODE_PROJECT": "tsconfig.json"
    },
    "files": [
      "tests/**/*.spec.ts"
    ]
  },
  "dependencies": {
    "@circuit/electronics": "workspace:*",
    "@circuit/math": "workspace:*",
    "@circuit/shared": "workspace:*",
    "@xiao-ai/utils": "1.6.6"
  },
  "devDependencies": {
    "@circuit/eslint-config": "workspace:*",
    "@circuit/map": "workspace:*",
    "@types/circuit": "workspace:*",
    "@types/node": "18.11.9",
    "@xiao-ai/tsconfig": "1.0.4",
    "ava": "6.1.2",
    "eslint": "8.56.0",
    "rimraf": "5.0.5",
    "tslib": "2.6.2",
    "tsx": "4.7.3",
    "typescript": "5.4.5"
  }
}
