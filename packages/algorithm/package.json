{
  "name": "@circuit/algorithm",
  "description": "circuit's algorithm lib",
  "version": "1.0.0",
  "author": "xiaoboost",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "test": "pnpm run test:watch --run",
    "test:watch": "vitest -c ./vite.config.ts",
    "build:cjs": "tsc -p ./tsconfig.build.json",
    "build": "pnpm run clear && pnpm run build:cjs",
    "watch": "pnpm run build -w",
    "lint:type": "pnpm run build:cjs --noEmit",
    "lint:style": "eslint -c eslint.config.mjs",
    "lint:fix": "eslint --fix -c eslint.config.mjs",
    "lint": "pnpm run lint:type && pnpm run lint:style"
  },
  "dependencies": {
    "@xiao-ai/utils": "1.6.7",
    "bignumber.js": "9.3.0"
  },
  "devDependencies": {
    "@circuit/eslint-config": "workspace:*",
    "@circuit/test-toolkit": "workspace:*",
    "@types/circuit": "workspace:*",
    "@types/node": "20.19.0",
    "@xiao-ai/tsconfig": "1.0.4",
    "eslint": "9.17.0",
    "rimraf": "6.0.1",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
