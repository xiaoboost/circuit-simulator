{
  "name": "@circuit/inject",
  "description": "circuit's dependency injection library",
  "version": "1.0.0",
  "author": "xiaoboost",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "test": "pnpm run test:watch --run",
    "test:watch": "vitest",
    "build:cjs": "tsc -p ./tsconfig.build.json",
    "build": "pnpm run clear && pnpm run build:cjs",
    "watch": "pnpm run build -w",
    "lint:type": "pnpm run build:cjs --noEmit",
    "lint:style": "eslint -c eslint.config.mjs",
    "lint:fix": "eslint --fix -c eslint.config.mjs",
    "lint": "pnpm run lint:type && pnpm run lint:style"
  },
  "dependencies": {
    "@circuit/shared": "workspace:*",
    "@xiao-ai/utils": "1.6.7",
    "react": "19.1.1"
  },
  "devDependencies": {
    "@circuit/eslint-config": "workspace:*",
    "@circuit/test-toolkit": "workspace:*",
    "@types/circuit": "workspace:*",
    "@types/node": "20.19.0",
    "@types/react": "19.1.9",
    "@xiao-ai/tsconfig": "1.0.4",
    "eslint": "9.34.0",
    "rimraf": "6.0.1",
    "tslib": "2.8.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
