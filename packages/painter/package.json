{
  "name": "@circuit/painter",
  "description": "circuit's painter component",
  "version": "1.0.0",
  "author": "xiaoboost",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "test": "pnpm run test:watch --run",
    "test:watch": "vitest",
    "build:cjs": "tsc -p ./tsconfig.build.json",
    "build": "pnpm run clear && pnpm run build:cjs",
    "watch": "pnpm run build -w",
    "lint:type": "pnpm run build:cjs --noEmit",
    "lint:style": "eslint -c eslint.config.mjs",
    "lint:fix": "eslint --fix -c eslint.config.mjs",
    "lint": "pnpm run lint:type && pnpm run lint:style"
  },
  "dependencies": {
    "@circuit/algorithm": "workspace:*",
    "@circuit/contracts": "workspace:*",
    "@circuit/electronics": "workspace:*",
    "@circuit/icons": "workspace:*",
    "@circuit/inject": "workspace:*",
    "@circuit/reactive": "workspace:*",
    "@circuit/shared": "workspace:*",
    "@circuit/types": "workspace:*",
    "@floating-ui/dom": "1.7.4",
    "@xiao-ai/utils": "1.6.7",
    "antd": "5.28.1",
    "hotkeys-js": "3.13.15",
    "motion": "12.23.24",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@circuit/eslint-config": "workspace:*",
    "@circuit/inject-test-utils": "workspace:*",
    "@circuit/test-toolkit": "workspace:*",
    "@types/circuit": "workspace:*",
    "@types/node": "20.19.0",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "@xiao-ai/tsconfig": "1.0.4",
    "eslint": "9.39.1",
    "rimraf": "6.1.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "4.0.9"
  }
}
