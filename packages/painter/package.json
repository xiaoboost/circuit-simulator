{
  "name": "@circuit/painter",
  "description": "circuit's painter component",
  "version": "1.0.0",
  "author": "xiaoboost",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "test": "ava --no-cache --config ./ava.config.js",
    "build:cjs": "tsc -p ./tsconfig.build.json",
    "build": "pnpm run clear && pnpm run build:cjs",
    "watch": "pnpm run build -w",
    "lint": "eslint -c eslint.config.mjs",
    "lint:fix": "eslint --fix -c eslint.config.mjs"
  },
  "dependencies": {
    "@circuit/algorithm": "workspace:*",
    "@circuit/electronics": "workspace:*",
    "@circuit/icons": "workspace:*",
    "@circuit/inject": "workspace:*",
    "@circuit/map": "workspace:*",
    "@circuit/shared": "workspace:*",
    "@circuit/types": "workspace:*",
    "@xiao-ai/utils": "1.6.7",
    "antd": "5.25.3",
    "hotkeys-js": "3.13.9",
    "motion": "12.9.4",
    "react": "19.1.0",
    "react-use": "17.6.0"
  },
  "devDependencies": {
    "@circuit/eslint-config": "workspace:*",
    "@circuit/test-toolkit": "workspace:*",
    "@types/circuit": "workspace:*",
    "@types/node": "20.12.8",
    "@types/react": "19.1.2",
    "@xiao-ai/tsconfig": "1.0.4",
    "ava": "6.2.0",
    "eslint": "9.17.0",
    "rimraf": "5.0.5",
    "tslib": "2.8.1",
    "typescript": "5.8.3"
  }
}
