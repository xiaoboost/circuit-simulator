{
  "name": "@circuit/reactive",
  "description": "circuit's reactive lib",
  "version": "1.0.0",
  "author": "xiaoboost",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clear": "rimraf ./dist",
    "build:cjs": "tsc -p ./tsconfig.json",
    "build": "pnpm run clear && pnpm run build:cjs",
    "lint:type": "pnpm run build:cjs --noEmit",
    "lint:style": "eslint -c eslint.config.mjs",
    "lint:fix": "eslint --fix -c eslint.config.mjs",
    "lint": "pnpm run lint:type && pnpm run lint:style"
  },
  "dependencies": {
    "react": "19.1.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@circuit/eslint-config": "workspace:*",
    "@types/node": "20.19.0",
    "@types/react": "19.1.9",
    "@xiao-ai/tsconfig": "1.0.4",
    "eslint": "9.32.0",
    "rimraf": "6.0.1",
    "tslib": "2.8.1",
    "typescript": "5.8.3"
  }
}
