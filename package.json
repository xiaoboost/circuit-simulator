{
  "name": "circuit-simulator",
  "version": "1.0.0",
  "description": "电路仿真代码仓库",
  "scripts": {
    "test": "pnpm -r run --parallel test",
    "test:prepare": "pnpm run --filter @circuit/test-toolkit build",
    "test:update": "pnpm -r run --parallel test:update",
    "lint": "pnpm -r --parallel run lint",
    "lint:fix": "pnpm -r --parallel run lint:fix",
    "dev": "pnpm run --filter @circuit/website dev",
    "build": "pnpm run --filter @circuit/website build",
    "analyze": "pnpm run --filter @circuit/website analyze"
  },
  "engines": {
    "node": ">= 20.0.0",
    "pnpm": ">= 9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoboost/circuit-simulator.git"
  },
  "pnpm": {
    "updateConfig": {
      "ignoreDependencies": [
        "@types/node",
        "eslint"
      ]
    }
  }
}
