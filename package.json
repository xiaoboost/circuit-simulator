{
  "name": "circuit-simulator",
  "version": "1.0.0",
  "description": "电路仿真代码仓库",
  "scripts": {
    "build": "pnpm run --filter=!@circuit/website build",
    "test": "pnpm run -r --parallel --filter . test",
    "test:update": "pnpm run -r --parallel --filter . test:update",
    "lint": "pnpm run -r --parallel --filter . lint",
    "lint:fix": "pnpm run -r --parallel --filter . lint:fix",
    "dev:website": "pnpm run --filter @circuit/website dev",
    "build:website": "pnpm run --filter @circuit/website build"
  },
  "engines": {
    "node": ">= 16.0.0",
    "pnpm": ">= 7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoboost/circuit-simulator.git"
  },
  "updateConfig": {
    "ignoreDependencies": [
      "@types/node"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "5.57.0",
    "@typescript-eslint/parser": "5.57.0",
    "eslint": "8.37.0",
    "eslint-plugin-react": "7.32.2"
  }
}
